      "id": "35df54e3-3766-449b-857e-94ee6264d8ed",
      "name": "Start"
    },
    {
      "parameters": {
        "jsCode": "const startDate = $('Start').first().json.startDate;\nconst endDate = $('Start').first().json.endDate;\n\nconst start = new Date(startDate);\nconst end = new Date(endDate);\nend.setHours(23, 59, 59, 999);\n\nconst rows = $('Get row(s) in sheet').all();\n\nconst calls = rows.filter(row => {\n  if (row.json.Status !== \"Done\") return false;\n\n  const processedAt = new Date(row.json[\"Processed At\"]);\n\n  return processedAt >= start && processedAt <= end;\n});\n\nconst totalCalls = calls.length;\n\nconst negativeCalls = calls.filter(\n  row => row.json.Tone === \"Негативний\"\n).length;\n\nreturn [\n  {\n    json: {\n      totalCalls,\n      negativeCalls,\n      negativeCallPercent:\n        totalCalls\n          ? Math.round((negativeCalls / totalCalls) * 100)\n          : 0\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
