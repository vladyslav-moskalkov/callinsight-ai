    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n\n  if (!item.json.Status || item.json.Status === \"\") {\n\n    const url = item.json[\"Recording URL\"];\n\n    const fileId = url.match(/\\/d\\/([^/]+)/)[1];\n\n    const downloadLink =\n      \"https://drive.google.com/uc?export=download&id=\" + fileId;\n\n    return [{\n      json: {\n        ...item.json,\n        downloadLink\n      }\n    }];\n\n  }\n\n}\n\nreturn [];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -16
      ],
      "id": "380b7469-ab70-4518-9444-f79849c5fbf4",
      "name": "Extract URL"
    },
    {
