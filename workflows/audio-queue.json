        "method": "POST",
        "url": "https://api.assemblyai.com/v2/transcript",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"audio_url\": \"{{ $json.downloadLink }}\",\n  \"speech_models\": [\"universal-2\"],\n  \"language_code\": \"uk\",\n  \"speaker_labels\": true,\n  \"speakers_expected\": 2\n}",
        "options": {}
      },
